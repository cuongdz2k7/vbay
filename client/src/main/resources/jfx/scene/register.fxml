<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.GaussianBlur?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<AnchorPane prefHeight="760.0" prefWidth="430.0" styleClass="register-screen" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.vbay.ui.scene.controller.registercontroller">
    <children>
        <Circle centerX="390.0" centerY="720.0" fill="#ff5e2b" mouseTransparent="true" opacity="0.12" radius="190.0">
            <effect>
                <GaussianBlur radius="135.0" />
            </effect>
        </Circle>

        <BorderPane prefHeight="760.0" prefWidth="430.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <top>
                <HBox alignment="CENTER_LEFT" spacing="12.0" BorderPane.alignment="CENTER">
                    <padding>
                        <Insets bottom="18.0" left="24.0" right="24.0" top="28.0" />
                    </padding>
                    <children>
                        <Label styleClass="register-logo" text="Vbay" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Hyperlink focusTraversable="false" onAction="#handleBackToHome" styleClass="header-link" text="BACK TO HOME" />
                    </children>
                </HBox>
            </top>

            <center>
                <StackPane BorderPane.alignment="CENTER">
                    <padding>
                        <Insets bottom="16.0" left="16.0" right="16.0" top="8.0" />
                    </padding>
                    <children>
                        <VBox maxWidth="384.0" prefWidth="384.0" spacing="0.0" styleClass="register-card">
                            <padding>
                                <Insets bottom="34.0" left="28.0" right="28.0" top="34.0" />
                            </padding>

                            <VBox spacing="8.0">
                                <children>
                                    <Label styleClass="access-tag" text="ACCESS PORTAL" />
                                    <Label styleClass="register-title" text="Create account" />
                                </children>
                            </VBox>

                            <VBox spacing="28.0">
                                <VBox.margin>
                                    <Insets top="30.0" />
                                </VBox.margin>
                                <children>
                                    <VBox spacing="8.0">
                                        <children>
                                            <Label styleClass="register-label" text="FULL NAME" />
                                            <TextField fx:id="fullNameField" onAction="#handleRegister" promptText="ARCHITECT NAME" styleClass="register-input" />
                                        </children>
                                    </VBox>

                                    <VBox spacing="8.0">
                                        <children>
                                            <Label styleClass="register-label" text="EMAIL ADDRESS" />
                                            <TextField fx:id="emailField" onAction="#handleRegister" promptText="IDENTITY@VBAY.COM" styleClass="register-input" />
                                        </children>
                                    </VBox>

                                    <HBox spacing="24.0">
                                        <children>
                                            <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                                <children>
                                                    <Label styleClass="register-label" text="PASSWORD" />
                                                    <PasswordField fx:id="passwordField" onAction="#handleRegister" promptText="........" styleClass="register-input register-password-input" />
                                                </children>
                                            </VBox>

                                            <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                                <children>
                                                    <Label styleClass="register-label" text="CONFIRM" />
                                                    <PasswordField fx:id="confirmPasswordField" onAction="#handleRegister" promptText="........" styleClass="register-input register-password-input" />
                                                </children>
                                            </VBox>
                                        </children>
                                    </HBox>

                                    <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleRegister" prefHeight="50.0" styleClass="register-submit-button" text="INITIALIZE ACCOUNT">
                                        <VBox.margin>
                                            <Insets top="6.0" />
                                        </VBox.margin>
                                    </Button>
                                </children>
                            </VBox>

                            <VBox spacing="0.0" styleClass="register-card-footer">
                                <padding>
                                    <Insets top="28.0" />
                                </padding>
                                <VBox.margin>
                                    <Insets top="34.0" />
                                </VBox.margin>
                                <children>
                                    <HBox alignment="CENTER_LEFT" spacing="4.0">
                                        <children>
                                            <Label styleClass="register-footer-copy" text="Already part of the monolith?" />
                                            <Hyperlink focusTraversable="false" onAction="#handleBackToLogin" styleClass="register-footer-link" text="Log In" />
                                            <Label styleClass="register-footer-arrow" text="→" />
                                        </children>
                                    </HBox>
                                </children>
                            </VBox>
                        </VBox>
                    </children>
                </StackPane>
            </center>

            <bottom>
                <HBox alignment="CENTER" spacing="18.0" styleClass="register-page-footer" BorderPane.alignment="CENTER">
                    <padding>
                        <Insets bottom="24.0" left="18.0" right="18.0" top="12.0" />
                    </padding>
                    <children>
                        <Label styleClass="register-footer-strip" text="COPYRIGHT 2024 VBAY ARCHITECTURAL SYSTEMS" />
                        <Label styleClass="register-footer-strip" text="COPYRIGHT 2024 VBAY ARCHITECTURAL SYSTEMS" />
                    </children>
                </HBox>
            </bottom>
        </BorderPane>
    </children>
</AnchorPane>
