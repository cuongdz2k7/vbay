<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.shape.SVGPath?>

<AnchorPane prefHeight="760.0" prefWidth="430.0" styleClass="register-screen" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.vbay.ui.scene.controller.registercontroller">
    <children>
        <BorderPane prefHeight="760.0" prefWidth="430.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <top>
                <HBox alignment="CENTER_LEFT" styleClass="register-topbar" BorderPane.alignment="CENTER">
                    <padding>
                        <Insets bottom="24.0" left="24.0" right="24.0" top="28.0" />
                    </padding>

                    <children>
                        <Label styleClass="register-brand" text="VBAY" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Hyperlink focusTraversable="false" onAction="#handleBackToHome" styleClass="header-link" text="BACK TO HOME" />
                    </children>
                </HBox>
            </top>

            <center>
                <StackPane styleClass="register-stage" BorderPane.alignment="CENTER">
                    <children>
                        <Region styleClass="register-stage-glow" />

                        <VBox alignment="TOP_RIGHT" mouseTransparent="true" pickOnBounds="false">
                            <padding>
                                <Insets right="44.0" top="58.0" />
                            </padding>
                            <children>
                                <Region minHeight="180.0" VBox.vgrow="ALWAYS" />
                                <StackPane prefHeight="220.0" prefWidth="120.0">
                                    <children>
                                        <Line endX="0.0" endY="200.0" startX="0.0" startY="0.0" stroke="#5b4039" strokeLineCap="BUTT" strokeWidth="1.0" translateX="118.0" />
                                        <Line endX="110.0" endY="0.0" startX="0.0" startY="0.0" stroke="#5b4039" strokeLineCap="BUTT" strokeWidth="1.0" translateY="200.0" />
                                    </children>
                                </StackPane>
                            </children>
                        </VBox>

                        <VBox alignment="CENTER" fillWidth="true">
                            <padding>
                                <Insets bottom="24.0" left="16.0" right="16.0" top="24.0" />
                            </padding>

                            <children>
                                <VBox maxWidth="430.0" prefWidth="430.0" spacing="0.0" styleClass="register-card">
                                    <padding>
                                        <Insets bottom="36.0" left="36.0" right="36.0" top="36.0" />
                                    </padding>

                                    <children>
                                        <VBox spacing="8.0">
                                            <children>
                                                <Label styleClass="access-tag" text="ACCESS PORTAL" />
                                                <Label styleClass="register-title" text="Create Account" />
                                            </children>
                                        </VBox>

                                        <VBox spacing="24.0">
                                            <VBox.margin>
                                                <Insets top="34.0" />
                                            </VBox.margin>

                                            <children>
                                                <VBox spacing="8.0">
                                                    <children>
                                                        <Label styleClass="register-label" text="FULL NAME" />
                                                        <TextField fx:id="fullNameField" onAction="#handleRegister" promptText="ARCHITECT NAME" styleClass="register-input" />
                                                    </children>
                                                </VBox>

                                                <VBox spacing="8.0">
                                                    <children>
                                                        <Label styleClass="register-label" text="EMAIL ADDRESS" />
                                                        <TextField fx:id="emailField" onAction="#handleRegister" promptText="IDENTITY@OBSIDIAN.COM" styleClass="register-input" />
                                                    </children>
                                                </VBox>

                                                <HBox spacing="24.0">
                                                    <children>
                                                        <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                                            <children>
                                                                <Label styleClass="register-label" text="PASSWORD" />
                                                                <PasswordField fx:id="passwordField" maxWidth="1.7976931348623157E308" onAction="#handleRegister" promptText="........" styleClass="register-input" />
                                                            </children>
                                                        </VBox>

                                                        <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                                            <children>
                                                                <Label styleClass="register-label" text="CONFIRM" />
                                                                <PasswordField fx:id="confirmPasswordField" maxWidth="1.7976931348623157E308" onAction="#handleRegister" promptText="........" styleClass="register-input" />
                                                            </children>
                                                        </VBox>
                                                    </children>
                                                </HBox>

                                                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleRegister" prefHeight="52.0" styleClass="register-submit-button" text="INITIALIZE ACCOUNT">
                                                    <VBox.margin>
                                                        <Insets top="8.0" />
                                                    </VBox.margin>
                                                </Button>
                                            </children>
                                        </VBox>

                                        <VBox spacing="16.0" styleClass="register-card-footer">
                                            <padding>
                                                <Insets top="28.0" />
                                            </padding>
                                            <VBox.margin>
                                                <Insets top="34.0" />
                                            </VBox.margin>

                                            <children>
                                                <Hyperlink focusTraversable="false" onAction="#handleBackToLogin" styleClass="register-login-link">
                                                    <graphic>
                                                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                                                            <children>
                                                                <Label styleClass="register-footer-copy" text="Already part of the monolith?" />
                                                                <Label styleClass="register-footer-link-text" text="Log in" />
                                                                <SVGPath content="M1 1 L11 6 L1 11" scaleX="0.85" scaleY="0.85" styleClass="register-footer-arrow" />
                                                            </children>
                                                        </HBox>
                                                    </graphic>
                                                </Hyperlink>
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>

                    </children>
                </StackPane>
            </center>

            <bottom>
                <VBox alignment="CENTER" spacing="16.0" styleClass="footer-bar">
                    <padding>
                        <Insets bottom="24.0" left="24.0" right="24.0" top="22.0" />
                    </padding>

                    <children>
                        <Label styleClass="footer-copy" text="COPYRIGHT 2024 OBSIDIAN ARCHITECTURAL SYSTEMS" />
                        <HBox alignment="CENTER" spacing="28.0">
                            <children>
                                <Hyperlink focusTraversable="false" styleClass="muted-link footer-link" text="PRIVACY" />
                                <Hyperlink focusTraversable="false" styleClass="muted-link footer-link" text="TERMS" />
                                <Hyperlink focusTraversable="false" styleClass="muted-link footer-link" text="SUPPORT" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </bottom>
        </BorderPane>
    </children>
</AnchorPane>
