<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane prefHeight="720.0" prefWidth="1180.0" styleClass="admin-root" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.vbay.ui.scene_ui.controller.admin.AdminDashboardController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="18.0" styleClass="admin-topbar">
            <padding>
                <Insets bottom="16.0" left="24.0" right="24.0" top="16.0" />
            </padding>
            <children>
                <VBox spacing="2.0">
                    <children>
                        <Label text="VBAY ADMIN" styleClass="admin-brand" />
                        <Label text="Management console" styleClass="admin-subtitle" />
                    </children>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <VBox alignment="CENTER_RIGHT" spacing="2.0">
                    <children>
                        <Label fx:id="adminNameLabel" text="Admin" styleClass="admin-name" />
                        <Label fx:id="roleLabel" text="ADMIN" styleClass="admin-role" />
                    </children>
                </VBox>
                <Button text="Logout" onAction="#handleLogout" styleClass="admin-logout-btn" />
            </children>
        </HBox>
    </top>

    <left>
        <VBox prefWidth="260.0" spacing="10.0" styleClass="admin-sidebar">
            <padding>
                <Insets bottom="22.0" left="18.0" right="18.0" top="22.0" />
            </padding>
            <children>
                <Button maxWidth="Infinity" styleClass="admin-nav-item active-admin-nav">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <SVGPath content="M4 4H16V16H4ZM7 7H13M7 10H13M7 13H10" styleClass="admin-nav-icon" />
                                <Label text="Users" styleClass="admin-nav-label" />
                            </children>
                        </HBox>
                    </graphic>
                </Button>
                <Button maxWidth="Infinity" styleClass="admin-nav-item">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <SVGPath content="M3 15L8 5L12 11L15 8L18 15Z" styleClass="admin-nav-icon" />
                                <Label text="Auctions" styleClass="admin-nav-label" />
                            </children>
                        </HBox>
                    </graphic>
                </Button>
            </children>
        </VBox>
    </left>

    <center>
        <VBox spacing="18.0" styleClass="admin-content">
            <padding>
                <Insets bottom="28.0" left="28.0" right="28.0" top="28.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="16.0">
                    <children>
                        <VBox spacing="4.0">
                            <children>
                                <Label text="Users" styleClass="admin-page-title" />
                                <Label text="Review user accounts and control access when needed." styleClass="admin-page-subtitle" />
                            </children>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button text="Refresh" onAction="#handleRefresh" styleClass="admin-primary-btn" />
                    </children>
                </HBox>

                <HBox spacing="16.0">
                    <children>
                        <VBox spacing="8.0" styleClass="admin-stat">
                            <children>
                                <Label text="Total Users" styleClass="admin-stat-label" />
                                <Label fx:id="totalUsersLabel" text="0" styleClass="admin-stat-value" />
                            </children>
                        </VBox>
                        <VBox spacing="8.0" styleClass="admin-stat">
                            <children>
                                <Label text="Active" styleClass="admin-stat-label" />
                                <Label fx:id="activeUsersLabel" text="0" styleClass="admin-stat-value" />
                            </children>
                        </VBox>
                        <VBox spacing="8.0" styleClass="admin-stat">
                            <children>
                                <Label text="Banned" styleClass="admin-stat-label" />
                                <Label fx:id="bannedUsersLabel" text="0" styleClass="admin-stat-value" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <VBox spacing="10.0" styleClass="admin-panel">
                    <children>
                        <HBox alignment="CENTER_LEFT" styleClass="admin-table-head">
                            <children>
                                <Label text="USERNAME" styleClass="admin-col-user" />
                                <Label text="ROLE" styleClass="admin-col-role" />
                                <Label text="STATUS" styleClass="admin-col-status" />
                                <Label text="CREATED AT" styleClass="admin-col-created" />
                                <Label text="ACTION" styleClass="admin-col-action" />
                            </children>
                        </HBox>
                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="admin-table-scroll">
                            <content>
                                <VBox fx:id="userListContainer" spacing="8.0" />
                            </content>
                        </ScrollPane>
                        <VBox fx:id="emptyState" alignment="CENTER" minHeight="220.0" spacing="8.0" styleClass="admin-empty-state">
                            <children>
                                <Label text="No users loaded" styleClass="admin-empty-title" />
                                <Label text="Refresh the list to load user management data." styleClass="admin-empty-copy" />
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </center>
</BorderPane>
