<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane fx:id="adminRoot" styleClass="admin-dashboard" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.vbay.ui.scene_ui.controller.admin.AdminDashboardController">
    <left>
        <VBox styleClass="sidebar">
            <VBox alignment="CENTER" spacing="10" styleClass="sidebar-header">
                <SVGPath content="M12 2L2 22h20L12 2z" styleClass="logo-icon" />
                <Label styleClass="logo-text" text="vBay Admin" />
                <Label styleClass="sidebar-subtitle" text="Superuser Control Panel" />
            </VBox>
            
            <VBox spacing="10" VBox.vgrow="ALWAYS">
                <Button fx:id="userManagementBtn" maxWidth="Infinity" onAction="#showUserManagement" styleClass="nav-button, active-nav" text="User Management">
                    <graphic>
                        <SVGPath content="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" styleClass="nav-icon" />
                    </graphic>
                </Button>
                
                <Button fx:id="auctionManagementBtn" maxWidth="Infinity" onAction="#showAuctionManagement" styleClass="nav-button" text="Auction Management">
                    <graphic>
                        <SVGPath content="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 9h-2V7h-2v5H6v2h2v5h2v-5h2v-2h2v-2h-2z" styleClass="nav-icon" />
                    </graphic>
                </Button>
            </VBox>
            
            <VBox spacing="10" styleClass="sidebar-footer">
                <Label fx:id="accountNameLabel" styleClass="account-name" text="Admin" />
                <Button maxWidth="Infinity" onAction="#handleLogout" styleClass="logout-btn" text="Sign Out" />
            </VBox>
        </VBox>
    </left>
    
    <center>
        <VBox fx:id="contentArea" spacing="20" styleClass="content-area">
            <padding>
                <Insets bottom="30" left="40" right="40" top="30" />
            </padding>
            
            <StackPane VBox.vgrow="ALWAYS">
                <!-- User Management View -->
                <VBox fx:id="userManagementView" spacing="20">
                    <HBox alignment="CENTER_LEFT">
                        <Label styleClass="page-title" text="User Management" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button onAction="#refreshUsers" styleClass="action-button" text="Refresh" />
                    </HBox>
                    <TableView fx:id="usersTable" VBox.vgrow="ALWAYS" styleClass="glass-table">
                        <columns>
                            <TableColumn fx:id="userIdCol" text="ID" prefWidth="50" />
                            <TableColumn fx:id="usernameCol" text="Username" prefWidth="120" />
                            <TableColumn fx:id="userEmailCol" text="Email" prefWidth="180" />
                            <TableColumn fx:id="userStatusCol" text="Status" prefWidth="90" />
                            <TableColumn fx:id="userWarnCol" text="Warnings" prefWidth="80" />
                            <TableColumn fx:id="userLockCol" text="Lock Until" prefWidth="200" />
                            <TableColumn fx:id="userActionCol" text="Actions" prefWidth="380" />
                        </columns>
                    </TableView>
                </VBox>
                
                <!-- Auction Management View -->
                <VBox fx:id="auctionManagementView" spacing="20" visible="false">
                    <HBox alignment="CENTER_LEFT">
                        <Label styleClass="page-title" text="Auction Management" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button onAction="#refreshAuctions" styleClass="action-button" text="Refresh" />
                    </HBox>
                    <TableView fx:id="auctionsTable" VBox.vgrow="ALWAYS" styleClass="glass-table">
                        <columns>
                            <TableColumn fx:id="auctionIdCol" text="ID" prefWidth="50" />
                            <TableColumn fx:id="auctionSellerCol" text="Seller ID" prefWidth="80" />
                            <TableColumn fx:id="auctionTitleCol" text="Title" prefWidth="200" />
                            <TableColumn fx:id="auctionStatusCol" text="Status" prefWidth="100" />
                            <TableColumn fx:id="auctionPriceCol" text="Current Price" prefWidth="120" />
                            <TableColumn fx:id="auctionEndCol" text="Ends At" prefWidth="150" />
                            <TableColumn fx:id="auctionActionCol" text="Actions" prefWidth="240" />
                        </columns>
                    </TableView>
                </VBox>
            </StackPane>
        </VBox>
    </center>
</BorderPane>
