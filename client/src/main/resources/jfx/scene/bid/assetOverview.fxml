<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            prefWidth="1280" prefHeight="860"
            styleClass="asset-overview-root"
            fx:controller="com.vbay.ui.scene.controller.bid.AssetOverviewController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="14" styleClass="asset-overview-topbar">
            <padding>
                <Insets top="16" right="22" bottom="16" left="22"/>
            </padding>
            <Button text="Back" onAction="#handleBack" styleClass="back-btn"/>
            <VBox spacing="2">
                <Label text="Current Asset" styleClass="page-title"/>
                <Label text="Scrollable asset summary and lot details." styleClass="page-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="asset-overview-scroll">
            <content>
                <VBox alignment="TOP_CENTER" fillWidth="true" styleClass="asset-overview-content">
                    <padding>
                        <Insets top="18" right="18" bottom="18" left="18"/>
                    </padding>

                    <VBox spacing="14" styleClass="asset-sheet" maxWidth="720">
                        <Label text="CURRENT ASSET" styleClass="eyebrow-label"/>
                        <Label fx:id="assetCodeLabel" text="LOT-UNSET" styleClass="asset-code"/>
                        <ImageView fx:id="productImageView" fitWidth="680" fitHeight="360" preserveRatio="false" styleClass="hero-image"/>

                        <VBox spacing="8">
                            <Label fx:id="titleLabel" text="Product title" styleClass="product-title" wrapText="true"/>
                            <Label text="Product Summary" styleClass="section-title"/>
                            <Label fx:id="summaryLabel" text="Summary" styleClass="summary-label" wrapText="true"/>
                        </VBox>

                        <VBox spacing="10">
                            <Label text="Lot Details" styleClass="section-title"/>
                            <GridPane hgap="12" vgap="12" styleClass="detail-grid">
                                <children>
                                    <VBox spacing="4" styleClass="detail-card" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                        <Label text="Current Bid" styleClass="detail-label"/>
                                        <Label fx:id="currentBidLabel" text="\$0.00" styleClass="detail-value"/>
                                    </VBox>
                                    <VBox spacing="4" styleClass="detail-card" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                        <Label text="Starting Price" styleClass="detail-label"/>
                                        <Label fx:id="startingPriceLabel" text="\$0.00" styleClass="detail-value"/>
                                    </VBox>
                                    <VBox spacing="4" styleClass="detail-card" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                        <Label text="Bid Step" styleClass="detail-label"/>
                                        <Label fx:id="stepLabel" text="\$0.00" styleClass="detail-value"/>
                                    </VBox>
                                    <VBox spacing="4" styleClass="detail-card" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                        <Label text="Time Left" styleClass="detail-label"/>
                                        <Label fx:id="timeLeftLabel" text="0h 00m left" styleClass="detail-value"/>
                                    </VBox>
                                    <VBox spacing="4" styleClass="detail-card wide" GridPane.columnIndex="0" GridPane.rowIndex="2" GridPane.columnSpan="2">
                                        <Label text="Auction Activity" styleClass="detail-label"/>
                                        <Label fx:id="activityLabel" text="0% activity" styleClass="detail-value accent"/>
                                    </VBox>
                                </children>
                            </GridPane>
                        </VBox>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>
