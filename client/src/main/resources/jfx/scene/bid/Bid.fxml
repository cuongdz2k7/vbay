<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            prefWidth="1280" prefHeight="860"
            styleClass="bid-root"
            fx:controller="com.vbay.ui.scene_ui.controller.bid.BidController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="16" styleClass="bid-topbar">
            <padding>
                <Insets top="18" right="24" bottom="18" left="24"/>
            </padding>
            <Button text="Back" onAction="#handleBack" styleClass="back-btn"/>
            <VBox spacing="4">
                <Label text="Live Auction Detail" styleClass="page-title"/>
                <Label text="Inspect the item and continue to bidding later." styleClass="page-subtitle"/>
            </VBox>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="bid-scroll">
            <content>
                <HBox spacing="30" styleClass="bid-content" alignment="TOP_LEFT">
                    <padding>
                        <Insets top="24" right="24" bottom="24" left="24"/>
                    </padding>

                    <VBox spacing="24"
                          prefWidth="560"
                          minWidth="560"
                          maxWidth="560"
                          styleClass="left-column-frame"
                          HBox.hgrow="NEVER">

                        <VBox styleClass="image-showcase">
                            <ImageView fx:id="productImageView" fitWidth="520" fitHeight="320" preserveRatio="false" styleClass="hero-image"/>
                        </VBox>

                        <VBox spacing="16" styleClass="bid-panel side-action-panel place-bid-panel" alignment="TOP_CENTER">
                            <padding>
                                <Insets top="20" right="24" bottom="20" left="24"/>
                            </padding>
                            <Label text="Place a Bid" styleClass="section-title"/>
                            <Label text="Input only for layout preview. No bid logic is connected yet." 
                                   styleClass="placeholder-text" 
                                   wrapText="true" 
                                   textAlignment="CENTER"/>
                            <Button text="Submit Bid"
                                    onAction="#handleOpenPlaceBid"
                                    maxWidth="Infinity"
                                    prefHeight="40"
                                    styleClass="submit-bid-btn"/>
                        </VBox>
                        <VBox spacing="18" styleClass="bid-panel side-action-panel buy-now-panel" alignment="TOP_CENTER">
                            <padding>
                                <Insets top="20" right="24" bottom="20" left="24"/>
                            </padding>
                            <Label text="Trusted seller with 99% positive feedback. Item ships from California, USA."
                                   styleClass="placeholder-text"
                                   wrapText="true"
                                   textAlignment="CENTER"/>
                            <Button text="Buy Now"
                                    onAction="#handleOpenByNow"
                                    maxWidth="Infinity"
                                    prefHeight="40"
                                    styleClass="buy-now-btn"/>
                        </VBox>
                    </VBox>

                    <VBox spacing="18" styleClass="bid-panel details-panel" HBox.hgrow="ALWAYS">
                        
                        <Label fx:id="titleLabel" text="Product title" styleClass="product-title" wrapText="true"/>
                        <Label fx:id="priceLabel" text="\$0.00" styleClass="product-price"/>
                        <Label fx:id="timeLabel" text="0h 00m left" styleClass="product-time"/>
                        <ProgressBar fx:id="progressBar" maxWidth="Infinity" progress="0.0"/>
                        
                        <Label text="About this lot" styleClass="section-title">
                            <VBox.margin>
                                <Insets top="10"/>
                            </VBox.margin>
                        </Label>
                        
                        <VBox styleClass="description-frame" alignment="TOP_LEFT" fillWidth="true" VBox.vgrow="ALWAYS">
                            <Label fx:id="descriptionLabel"
                                   text="Product description"
                                   styleClass="product-description"
                                   wrapText="true"
                                   maxWidth="Infinity"/>
                        </VBox>
                    </VBox>
                    
                </HBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>
