<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            prefWidth="1440" prefHeight="900"
            styleClass="place-bid-root"
            fx:controller="com.vbay.ui.scene_ui.controller.bid.PlaceBidController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="16" styleClass="place-bid-topbar">
            <padding>
                <Insets top="18" right="24" bottom="18" left="24"/>
            </padding>
            <Button text="Back" onAction="#handleBack" styleClass="back-btn"/>
            <VBox spacing="3">
                <Label text="Place Bid" styleClass="page-title"/>
                <Label text="F11 toggles fullscreen. Esc returns to overview mode." styleClass="page-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="LIVE AUCTION" styleClass="live-pill"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" pannable="true" styleClass="place-bid-scroll">
            <content>
                <VBox spacing="22" alignment="TOP_CENTER" fillWidth="true" styleClass="place-bid-content">
                    <padding>
                        <Insets top="18" right="18" bottom="18" left="18"/>
                    </padding>

                    <HBox spacing="20" alignment="TOP_LEFT" styleClass="place-bid-shell">
                            <VBox spacing="14" styleClass="visual-panel" prefWidth="540" maxWidth="540">
                                <Label text="CURRENT ASSET" styleClass="eyebrow-label"/>
                                <Label fx:id="assetCodeLabel" text="LOT-UNSET" styleClass="asset-code"/>
                                <ImageView fx:id="productImageView" fitWidth="500" fitHeight="280" preserveRatio="false" styleClass="hero-image"/>
                                <Label fx:id="assetNameLabel" text="Product title" styleClass="asset-name" wrapText="true"/>
                                <VBox spacing="10" styleClass="history-panel">
                                    <Label text="Bid History" styleClass="section-title"/>
                                    <HBox alignment="CENTER_LEFT" styleClass="history-row">
                                        <Label fx:id="historyBidderOneLabel" text="Bidder 1" styleClass="history-bidder"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Label fx:id="historyAmountOneLabel" text="\$0.00" styleClass="history-amount"/>
                                    </HBox>
                                    <HBox alignment="CENTER_LEFT" styleClass="history-row">
                                        <Label fx:id="historyBidderTwoLabel" text="Bidder 2" styleClass="history-bidder"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Label fx:id="historyAmountTwoLabel" text="\$0.00" styleClass="history-amount"/>
                                    </HBox>
                                    <HBox alignment="CENTER_LEFT" styleClass="history-row">
                                        <Label fx:id="historyBidderThreeLabel" text="Bidder 3" styleClass="history-bidder"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Label fx:id="historyAmountThreeLabel" text="\$0.00" styleClass="history-amount"/>
                                    </HBox>
                                </VBox>
                            </VBox>

                        <VBox spacing="16" styleClass="bid-panel" prefWidth="460" minWidth="460" maxWidth="460">
                            <VBox spacing="4">
                                <Label text="VERIFIED ASSET" styleClass="eyebrow-label accent"/>
                                <Label fx:id="titleLabel" text="Product title" styleClass="product-title" wrapText="true"/>
                            </VBox>

                            <HBox spacing="0" styleClass="stats-grid">
                                <VBox spacing="6" styleClass="stat-card" HBox.hgrow="ALWAYS">
                                    <Label text="Starting Price" styleClass="stat-label"/>
                                    <Label fx:id="startingPriceLabel" text="\$0.00" styleClass="stat-value"/>
                                </VBox>
                                <VBox spacing="6" styleClass="stat-card" HBox.hgrow="ALWAYS">
                                    <Label text="Current Bid" styleClass="stat-label"/>
                                    <Label fx:id="currentBidLabel" text="\$0.00" styleClass="stat-value"/>
                                </VBox>
                            </HBox>

                            <HBox spacing="0" styleClass="stats-grid">
                                <VBox spacing="6" styleClass="stat-card" HBox.hgrow="ALWAYS">
                                    <Label text="Bid Step" styleClass="stat-label"/>
                                    <Label fx:id="stepLabel" text="\$0.00" styleClass="stat-value"/>
                                </VBox>
                                <VBox spacing="6" styleClass="stat-card" HBox.hgrow="ALWAYS">
                                    <Label text="Next Valid Bid" styleClass="stat-label"/>
                                    <Label fx:id="nextBidLabel" text="\$0.00" styleClass="stat-value accent-value"/>
                                </VBox>
                            </HBox>

                            <HBox alignment="CENTER_LEFT">
                                <VBox spacing="6">
                                    <Label text="Time Remaining" styleClass="stat-label"/>
                                    <Label fx:id="timeLabel" text="0h 00m left" styleClass="countdown-label"/>
                                </VBox>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="progressPercentLabel" text="0% auction activity" styleClass="progress-copy"/>
                            </HBox>

                            <ProgressBar fx:id="progressBar" prefWidth="320" progress="0.0" styleClass="auction-progress"/>

                            <VBox spacing="8">
                                <Label text="Enter Bid Amount" styleClass="section-title"/>
                                <TextField fx:id="bidAmountField" onAction="#handlePlaceBid" promptText="Enter bid amount" styleClass="bid-input"/>
                            </VBox>

                            <Button text="PLACE BID" maxWidth="Infinity" onAction="#handlePlaceBid" styleClass="place-bid-btn"/>

                            <Label text="Secure acquisition protocol active. All bids are binding." styleClass="footer-copy" wrapText="true"/>
                        </VBox>
                    </HBox>

                    <VBox spacing="12" styleClass="quick-actions-panel">
                        <Label text="Quick Actions" styleClass="section-title"/>
                        <HBox spacing="12" maxWidth="738">
                            <Button text="SET PROXY BID" maxWidth="Infinity" onAction="#handleProxyBid" styleClass="secondary-action-btn" HBox.hgrow="ALWAYS"/>
                            <Button text="WATCH ASSET" maxWidth="Infinity" onAction="#handleWatchAsset" styleClass="secondary-action-btn" HBox.hgrow="ALWAYS"/>
                        </HBox>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>
