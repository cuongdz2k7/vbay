<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            prefWidth="1440" prefHeight="900"
            styleClass="root-layout">

    <top>
        <HBox spacing="20" alignment="CENTER_LEFT" styleClass="navbar">
            <padding>
                <Insets top="16" right="24" bottom="16" left="24"/>
            </padding>

            <HBox spacing="16" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                <Label text="vbay" styleClass="logo"/>

                <HBox spacing="8" alignment="CENTER_LEFT" styleClass="search-bar" HBox.hgrow="ALWAYS">
                    <Label text="🔍" styleClass="search-icon"/>
                    <TextField promptText="Search curated auctions..." HBox.hgrow="ALWAYS" styleClass="search-input"/>
                </HBox>
            </HBox>

            <HBox spacing="20" alignment="CENTER_RIGHT">
                <StackPane>
                    <Button text="🛒" styleClass="cart-btn"/>
                    <Label text="3" styleClass="cart-badge" StackPane.alignment="TOP_RIGHT"/>
                </StackPane>

                <HBox spacing="12" alignment="CENTER_LEFT" styleClass="user-profile">
                    <VBox spacing="2" alignment="CENTER_RIGHT">
                        <Label text="Julian Voss" styleClass="user-name"/>
                        <Label text="Pro Collector" styleClass="user-role"/>
                    </VBox>

                    <ImageView fitWidth="48" fitHeight="48" preserveRatio="true">
                        <image>
                            <Image url="https://lh3.googleusercontent.com/aida-public/AB6AXuAym-ZUKyLh_ZWnDKPuP-Jv_8AyjeJlOwWNH2NnXOwwpNHar2AwoBFpSHPvqnxALF7BlYLQAF3ytH1kw23PYXU_mbBdERAyZeF0Edb2SJP91rBJiKLBRhTM456xAMsNcL8XrdVmHBhm7epg_YSMnSs0pFRZksDlxKCMqqCGzapYPMbZ0bFYxvV9LRpTezuOUeCFFfjx5MIDu5xZs6KGnB2GYnnjKRU_LTd2PYZBunmUur1gJQyUhg5fv_iixkDAt9JQkl2m3VgRO48"/>
                        </image>
                    </ImageView>
                </HBox>
            </HBox>
        </HBox>
    </top>

    <left>
        <VBox prefWidth="260" spacing="16" styleClass="sidebar">
            <padding>
                <Insets top="24" right="16" bottom="24" left="16"/>
            </padding>

            <VBox spacing="4">
                <Label text="Categories" styleClass="sidebar-title"/>
                <Label text="Curated Collections" styleClass="sidebar-subtitle"/>
            </VBox>

            <VBox spacing="8" VBox.vgrow="ALWAYS">
                <Button text="Electronics" maxWidth="Infinity" styleClass="nav-item active"/>
                <Button text="Phones" maxWidth="Infinity" styleClass="nav-item"/>
                <Button text="Laptops" maxWidth="Infinity" styleClass="nav-item"/>
                <Button text="Collectibles" maxWidth="Infinity" styleClass="nav-item"/>
                <Button text="Art" maxWidth="Infinity" styleClass="nav-item"/>
                <Button text="Fashion" maxWidth="Infinity" styleClass="nav-item"/>
            </VBox>

            <VBox spacing="12" styleClass="selling-card">
                <Label text="Selling something?" styleClass="selling-text"/>
                <Button text="Create Listing" maxWidth="Infinity" styleClass="create-listing-btn"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="main-scroll">
            <content>
                <VBox spacing="24" styleClass="main-content">
                    <padding>
                        <Insets top="24" right="24" bottom="24" left="24"/>
                    </padding>

                    <HBox spacing="16" alignment="CENTER_LEFT" styleClass="filters-bar">
                        <ComboBox promptText="All Prices"/>
                        <ComboBox promptText="Active Bids"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <ComboBox promptText="Ending Soon"/>
                    </HBox>

                    <TilePane hgap="20" vgap="20" prefColumns="3" styleClass="auction-grid">
                        <VBox spacing="12" styleClass="auction-card">
                            <ImageView fitWidth="320" fitHeight="220" preserveRatio="false">
                                <image>
                                    <Image url="https://lh3.googleusercontent.com/aida-public/AB6AXuCYtUHr-ioy-k-2E8C5K9tImQG0KGM3z_cAaj0m1lxdon6yaAMKU4xNYtfhfJf25TIT47-dbPenRDh6IykvE1lh5w--BgeBbPNZG0Id33oM1pEvhJRcXzzIcv1T9jDdB4pyeFGuG2W9QNszm2rxUPU-Y68pZU2_IVwOhAs9TU6dwZs2tSxJKYie_NbnDoPBcM69ZWZdgPIldbP0wGo9pAlgWVmueF3FozawY4qt4PcTjSV0QgEdKnJqFxfZTEbKu3aAwBh1BAXvX3s"/>
                                </image>
                            </ImageView>
                            <Label text="Apple MacBook Pro 16 M3 Max" styleClass="card-title" wrapText="true"/>
                            <Label text="Current Bid: $3,450.00" styleClass="price"/>
                            <Label text="Time Left: 2h 45m" styleClass="time"/>
                            <ProgressBar progress="0.85" prefWidth="300"/>
                            <Button text="Place Bid" maxWidth="Infinity" styleClass="btn-primary"/>
                        </VBox>
                    </TilePane>

                    <HBox spacing="12" alignment="CENTER_RIGHT" styleClass="pagination">
                        <Label text="Page 1 of 12"/>
                        <Button text="&lt; Previous" disable="true"/>
                        <Button text="1"/>
                        <Button text="2"/>
                        <Button text="3"/>
                        <Button text="Next &gt;"/>
                    </HBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>
